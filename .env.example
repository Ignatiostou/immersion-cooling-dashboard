# Replace these placeholders with settings for your own database.
INFLUX_URL=http://localhost:8086
INFLUX_ORG=example-org
INFLUX_BUCKET=example-telemetry
INFLUX_TOKEN=replace-with-your-own-read-token
# Optional for local development; Docker Compose supplies its own Redis URL.
# REDIS_URL=redis://localhost:6379
INFLUX_MAX_CONCURRENCY=6
